# Python environments and generated bytecode
.venv/
__pycache__/
*.py[cod]
*.so

# Test, static-analysis, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.pytype/

# Environment files and secrets
.env
.env.*
!.env.example

# Local private candidate data
data/candidate/candidate_profile.yaml
data/candidate/private_user_inputs.yaml
data/candidate/source_material/
data/candidate/evidence/private/

# Résumés and application source documents
*.pdf
*.doc
*.docx
*.odt
*.rtf

# Local RAG/vector data
.local/
chroma/
*.chromadb

# Generated application artifacts and audit material
artifacts/*
!artifacts/.gitkeep
screenshots/
browser-state/
playwright-report/
test-results/
application-runs/
*.application-plan.json
*.application-draft.md
*.proofreading-review.json

# Per-site inspection outputs and selector captures
data/jobs/*/form_schema.json
data/jobs/*/site_capture/
data/jobs/*/selector_observations.json
data/jobs/*/form_inspection.md

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local evidence manifests contain source hashes and are regenerated locally
data/candidate/manifests/

# Local candidate material not intended for commits
data/candidate/legacy_evidence_backup/

# Generated local mock inspection reports
/artifacts/local_mock_form_inventory*.json
/artifacts/inspection/

# Runtime-generated artifacts may contain local paths or candidate-derived content.
/artifacts/*
!/artifacts/.gitkeep

# Local snapshot/handoff/process artifacts (contain local absolute paths)
.aisnap/
05_handoff_current-progress.json
dossier.txt
*.cleaned.patch
web-agent-global-cli-updates.patch

# Your approved candidate dossier (personal; never commit)
data/candidate/dossier.yaml
data/policy/
